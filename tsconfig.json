{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx"
  },
  "include": [
    "*.ts",
    "server/**/*.ts",
    "web/src/**/*.ts",
    "web/src/**/*.tsx"
  ],
  "exclude": [
    "src/**",
    "dist/**",
    "output/**",
    "node_modules/**"
  ]
}
